_TRACE_CACHE: Dict[str, Any] = {"data": None, "ts": 0.0}
_TRACE_LOCK = threading.Lock()


def get_cached_traces(ttl: float = 2.5, force: bool = False) -> List[Dict[str, Any]]:
    """Thread-safe TTL cache for collect_all_traces to eliminate redundant disk I/O under load."""
    now = time.time()
    with _TRACE_LOCK:
        if not force and _TRACE_CACHE["data"] is not None and (now - _TRACE_CACHE["ts"]) < ttl:
            return _TRACE_CACHE["data"]
        traces = collect_all_traces()
        _TRACE_CACHE["data"] = traces
        _TRACE_CACHE["ts"] = now
        return traces

