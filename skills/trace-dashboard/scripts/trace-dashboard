  <script>
    let autoRefreshTimer = null;
    let openDrawerIds = new Set();
    let currentNodeText = '';

    // Real-Time Second-by-Second Live Duration Clock Engine
    setInterval(() => {{
      document.querySelectorAll('[data-start-time-ms]').forEach(el => {{
        if (el.getAttribute('data-is-active') === 'true') {{
          const startMs = parseInt(el.getAttribute('data-start-time-ms'), 10);
          const elapsedSec = Math.max(0, Math.floor((Date.now() - startMs) / 1000));
          const h = Math.floor(elapsedSec / 3600);
          const m = Math.floor((elapsedSec % 3600) / 60);
          const s = elapsedSec % 60;
          const pad = n => String(n).padStart(2, '0');
          const timeStr = `${{pad(h)}}:${{pad(m)}}:${{pad(s)}}`;
          const timeSpan = el.querySelector('.duration-time');
          if (timeSpan) {{
            timeSpan.textContent = timeStr;
          }} else {{
            el.textContent = timeStr;
          }}
        }}
      }});
    }}, 1000);

    function toggleNavCollapse() {{
      const rail = document.getElementById('main-nav-rail');
      rail.classList.toggle('collapsed');
    }}

    function switchView(viewName, optConvId) {{
      document.querySelectorAll('.view-pane').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));

      const pane = document.getElementById('view-' + viewName);
      if (pane) pane.classList.add('active');

      const navBtn = document.getElementById('nav-btn-' + viewName);
      if (navBtn) navBtn.classList.add('active');

      const url = new URL(window.location.href);
      url.searchParams.set('view', viewName);
      if (optConvId) {{
        url.searchParams.set('conv', optConvId);
      }}
      window.history.pushState({{}}, '', url.toString());

      if (optConvId) {{
        window.location.href = url.toString();
      }}
    }}

    function switchSession(convId) {{
      const url = new URL(window.location.href);
      url.searchParams.set('view', 'traces');
      url.searchParams.set('conv', convId);
      window.location.href = url.toString();
    }}

    function setMapTurn(turnNum) {{
      const url = new URL(window.location.href);
      url.searchParams.set('view', 'map');
      if (turnNum === null) {{
        url.searchParams.delete('turn');
      }} else {{
        url.searchParams.set('turn', turnNum);
      }}
      window.location.href = url.toString();
    }}

    function filterTracesSessions() {{
      const q = document.getElementById('traces-filter-input').value.toLowerCase().trim();
      document.querySelectorAll('.conv-item').forEach(el => {{
        const title = el.getAttribute('data-title') || '';
        const model = el.getAttribute('data-model') || '';
        if (!q || title.includes(q) || model.includes(q)) {{
          el.style.display = 'block';
        }} else {{
          el.style.display = 'none';
        }}
      }});
    }}

    function switchTab(tabName) {{
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));

      const activeBtn = Array.from(document.querySelectorAll('.tab-btn')).find(b => b.getAttribute('onclick') && b.getAttribute('onclick').includes(tabName));
      if (activeBtn) activeBtn.classList.add('active');

      const targetPane = document.getElementById('tab-' + tabName);
      if (targetPane) targetPane.classList.add('active');

      const url = new URL(window.location.href);
      url.searchParams.set('tab', tabName);
      window.history.replaceState({{}}, '', url.toString());
    }}

    function onDrawerToggle(detailsEl) {{
      if (detailsEl.id) {{
        if (detailsEl.open) {{
          openDrawerIds.add(detailsEl.id);
        }} else {{
          openDrawerIds.delete(detailsEl.id);
        }}
      }}
    }}

    function inspectNode(nodeJsonStr) {{
      try {{
        const n = JSON.parse(nodeJsonStr);
        document.getElementById('node-inspector-title').textContent = (n.title || 'Node') + ` [${{n.category || 'tool'}}]`;
        document.getElementById('node-inspector-meta').textContent = `Timestamp: ${{n.timestamp || 'N/A'}} · Step: #${{n.step_index || 'N/A'}}`;
        const codeText = n.full_text || (n.args ? JSON.stringify(n.args, null, 2) : n.output_preview || n.subtitle || '');
        document.getElementById('node-inspector-code').textContent = codeText;
        currentNodeText = codeText;
        document.getElementById('node-inspector').classList.add('open');
      }} catch (err) {{
        console.error('Inspect node failed:', err);
      }}
    }}

    function closeNodeInspector() {{
      document.getElementById('node-inspector').classList.remove('open');
    }}

    function copyNodeText() {{
      const btn = document.getElementById('node-copy-btn');
      navigator.clipboard.writeText(currentNodeText).then(() => {{
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => {{ btn.textContent = orig; }}, 1800);
      }});
    }}

    function toggleAutoRefresh() {{
      const btn = document.getElementById('auto-refresh-btn');
      if (autoRefreshTimer) {{
        clearInterval(autoRefreshTimer);
        autoRefreshTimer = null;
        btn.textContent = 'Auto-Refresh (4s): OFF';
        btn.style.borderColor = 'var(--border)';
        btn.style.color = 'var(--text)';
      }} else {{
        autoRefreshTimer = setInterval(() => {{
          refreshSilently();
        }}, 4000);
        btn.textContent = 'Auto-Refresh (4s): ON';
        btn.style.borderColor = 'var(--cyan)';
        btn.style.color = 'var(--cyan)';
      }}
    }}

    async function refreshSilently() {{
      try {{
        const res = await fetch(window.location.href, {{ headers: {{ 'Accept': 'text/html' }} }});
        if (!res.ok) return;
        const htmlText = await res.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(htmlText, 'text/html');

        const activePaneId = document.querySelector('.view-pane.active')?.id;
        if (activePaneId) {{
          const freshPane = doc.getElementById(activePaneId);
          const currentPane = document.getElementById(activePaneId);
          if (freshPane && currentPane) {{
            const sTop = currentPane.scrollTop;
            currentPane.innerHTML = freshPane.innerHTML;
            currentPane.scrollTop = sTop;
          }}
        }}

        openDrawerIds.forEach(id => {{
          const el = document.getElementById(id);
          if (el) el.open = true;
        }});
      }} catch (err) {{
        console.error('Silent refresh failed:', err);
      }}
    }}

    async function loadStepData(convId, stepIndex, field, btn) {{
      const origText = btn.textContent;
      btn.textContent = 'Loading...';
      try {{
        const res = await fetch(`/api/step_output?conv=${{convId}}&step=${{stepIndex}}&field=${{field}}`);
        const data = await res.json();
        document.getElementById('modal-title').textContent = (field === 'thinking' ? 'Reasoning / Thought Trace' : 'Step Output') + ` (Step #${{stepIndex}})`;
        document.getElementById('modal-body').textContent = data.output;
        document.getElementById('output-modal').style.display = 'flex';
      }} catch (err) {{
        alert('Failed to load step data: ' + err.message);
      }} finally {{
        btn.textContent = origText;
      }}
    }}

    function closeModal() {{
      document.getElementById('output-modal').style.display = 'none';
    }}

    function copyText(btn, text) {{
      navigator.clipboard.writeText(text).then(() => {{
        const orig = btn.textContent;
        btn.textContent = 'Copied to Clipboard!';
        setTimeout(() => {{ btn.textContent = orig; }}, 1800);
      }}).catch(err => {{
        alert('Could not copy: ' + err);
      }});
    }}

    async function triggerSync(btn) {{
      const orig = btn.textContent;
      btn.textContent = 'Syncing...';
      try {{
        const res = await fetch('/api/sync');
        if (res.ok) {{
          btn.textContent = 'Synced to Wiki!';
          setTimeout(() => {{ btn.textContent = orig; }}, 1800);
        }} else {{
          btn.textContent = 'Sync Failed';
          setTimeout(() => {{ btn.textContent = orig; }}, 1800);
        }}
      }} catch (err) {{
        btn.textContent = 'Error';
        setTimeout(() => {{ btn.textContent = orig; }}, 1800);
      }}
    }}
  </script>
</body>
</html>"""


class TraceHandler(BaseHTTPRequestHandler):
    def do_HEAD(self):
        self.do_GET()

    def send_safe_response(self, content_type: str, body: bytes, status: int = 200):
        try:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_GET(self):
        try:
            parsed = urlparse(self.path)
            qs = parse_qs(parsed.query)

            allowed_routes = {"/", "/api/traces", "/api/step_output", "/api/system_prompt", "/api/diff", "/api/sync"}
            if parsed.path not in allowed_routes:
                self.send_safe_response("text/plain; charset=utf-8", b"404 Not Found", status=404)
                return

            conv_id = qs.get("conv", [""])[0]
            if conv_id and not re.match(r"^[0-9a-fA-F-]+$", conv_id):
                self.send_safe_response("text/plain; charset=utf-8", b"400 Invalid conversation ID format", status=400)
                return

            step_idx = qs.get("step", [""])[0]
            if step_idx and not re.match(r"^\d+$", step_idx):
                self.send_safe_response("text/plain; charset=utf-8", b"400 Invalid step index format", status=400)
                return

            view = qs.get("view", ["overview"])[0]
            tab = qs.get("tab", ["prompts"])[0]
            turn_str = qs.get("turn", [""])[0]
            active_turn = int(turn_str) if turn_str.isdigit() else None

            if parsed.path == "/api/sync":
                convs = get_cached_traces(force=True)
                written = sync_markdown_files(convs)
                body = json.dumps({"status": "ok", "synced": [str(w) for w in written]}, ensure_ascii=False).encode("utf-8")
                self.send_safe_response("application/json; charset=utf-8", body)
                return

            if parsed.path == "/api/traces":
                convs = get_cached_traces()
                limit_str = qs.get("limit", [""])[0]
                if limit_str.isdigit():
                    limit = int(limit_str)
                    if limit > 0:
                        convs = convs[:limit]
                elif limit_str.lower() != "all":
                    convs = convs[:50]
                body = json.dumps(convs, ensure_ascii=False, indent=2).encode("utf-8")
                self.send_safe_response("application/json; charset=utf-8", body)
                return

            if parsed.path == "/api/step_output":
                field = qs.get("field", ["content"])[0]
                output_text = "No output available"

                if conv_id and step_idx:
                    target_conv_dir = (BRAIN_DIR / conv_id).resolve()
                    if target_conv_dir.parent == BRAIN_DIR.resolve() and target_conv_dir.exists() and target_conv_dir.is_dir():
                        full_log = target_conv_dir / ".system_generated" / "logs" / "transcript_full.jsonl"
                        if full_log.exists():
                            with open(full_log, "r", encoding="utf-8", errors="replace") as f:
                                for line in f:
                                    try:
                                        d = json.loads(line)
                                        if str(d.get("step_index")) == str(step_idx):
                                            if field == "thinking":
                                                output_text = str(d.get("thinking", "")) or "(No thinking trace recorded)"
                                            else:
                                                output_text = str(d.get("content", "")) or "(Empty content output)"
                                            break
                                    except Exception:
                                        pass

                        if output_text == "No output available" and field == "content":
                            step_file = target_conv_dir / ".system_generated" / "steps" / step_idx / "output.txt"
                            if step_file.exists():
                                output_text = step_file.read_text(encoding="utf-8", errors="replace")

                resp_data = {"step": step_idx, "field": field, "output": output_text, "length": len(output_text)}
                body = json.dumps(resp_data, ensure_ascii=False).encode("utf-8")
                self.send_safe_response("application/json; charset=utf-8", body)
                return

            if parsed.path == "/api/system_prompt":
                convs = get_cached_traces()
                selected = next((c for c in convs if c["id"] == conv_id), convs[0] if convs else None)
                sys_info = get_system_prompt_info(selected["workspace"] if selected else str(FLEET_ROOT), conv_id or "")
                body = json.dumps(sys_info, ensure_ascii=False, indent=2).encode("utf-8")
                self.send_safe_response("application/json; charset=utf-8", body)
                return

            if parsed.path == "/api/diff":
                convs = get_cached_traces()
                selected = next((c for c in convs if c["id"] == conv_id), convs[0] if convs else None)
                edited_paths = [tf["path"] for tf in (selected.get("touched_files", []) if selected else []) if tf.get("mode") == "EDITED"]
                diff_data = get_git_diff_data(selected["workspace"] if selected else None, edited_paths)
                body = json.dumps(diff_data, ensure_ascii=False).encode("utf-8")
                self.send_safe_response("application/json; charset=utf-8", body)
                return

            convs = get_cached_traces()
            body = render_html(convs, conv_id or None, view, tab, active_turn).encode("utf-8")
            self.send_safe_response("text/html; charset=utf-8", body)

        except Exception as exc:
            err_body = f"500 Internal Server Error: {exc}\n".encode("utf-8")
            self.send_safe_response("text/plain; charset=utf-8", err_body, status=500)

    def log_message(self, format, *args):
        # Suppress noisy HTTP request logging in daemon mode
        return


def main():
    parser = argparse.ArgumentParser(description="Fleet Agent Trace & Token Telemetry Dashboard")
    parser.add_argument("--serve", action="store_true", help="Launch live HTTP telemetry daemon")
    parser.add_argument("--port", type=int, default=8765, help="Port to bind server (default: 8765)")
    parser.add_argument("--sync", action="store_true", help="Sync traces to wiki/AGENT_TRACES_DASHBOARD.md")
    parser.add_argument("--json", action="store_true", help="Output all traces as JSON to stdout")
    parser.add_argument("--open-obsidian", action="store_true", help="Open synced Markdown file in Obsidian")
    args = parser.parse_args()

    convs = collect_all_traces()

    if args.json:
        print(json.dumps(convs, ensure_ascii=False, indent=2))
        return

    if args.sync or not args.serve:
        written = sync_markdown_files(convs)
        for w in written:
            print(f"[fleet-telemetry] Synced traces to {w}")

    if args.open_obsidian:
        target_md = FLEET_ROOT / "wiki" / "AGENT_TRACES_DASHBOARD.md"
        try:
            subprocess.run(["open", "-a", "Obsidian", str(target_md)], check=False)
            print(f"[fleet-telemetry] Opened {target_md} in Obsidian")
        except Exception as e:
            print(f"[fleet-telemetry] Could not open Obsidian: {e}")

    if args.serve:
        server_address = ("127.0.0.1", args.port)
        httpd = ThreadingHTTPServer(server_address, TraceHandler)
        print("==================================================================")
        print(f"  Fleet Obsidian Telemetry HUD running at http://127.0.0.1:{args.port}")
        print("  Visual System: Obsidian Dark Telemetry (Linear/Anduril/Stripe HUD)")
        print("  Left Nav Rail: Overview, Traces Inspector, Flow Map, Analytics")
        print("  Endpoints: /, /api/traces, /api/step_output, /api/diff, /api/system_prompt, /api/sync")
        print("==================================================================")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\n[fleet-telemetry] Server shutting down.")
            httpd.server_close()


if __name__ == "__main__":
    main()
