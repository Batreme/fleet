        circ = 2 * math.pi * r
        dashoffset = circ * (1.0 - (min(100.0, sat["percent"]) / 100.0))

        svg_ring_html = f"""
        <div class="sat-ring-wrap" title="Context Saturation: {sat['percent']}%">
