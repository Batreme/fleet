def load_rate_cards() -> Dict[str, Dict[str, Any]]:
    rates = dict(DEFAULT_RATE_CARDS)
    override_paths = [
        Path.home() / ".gemini" / "antigravity-cli" / "model_rates.json",
        FLEET_ROOT / "config" / "model_rates.json",
    ]
    for p in override_paths:
        if p.exists():
            try:
                data = json.loads(p.read_text(encoding="utf-8"))
                for k, v in data.items():
                    rates[k.lower()] = v
            except Exception:
                pass
    return rates


def match_rate_card(model_str: str, rate_cards: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
    m_lower = model_str.lower()
    if "flash" in m_lower and "3.8" in m_lower:
        return rate_cards.get("gemini-3.8-flash", rate_cards["default"])
    if "argon" in m_lower or "gemini 4" in m_lower:
        return rate_cards.get("gemini-4-argon", rate_cards["default"])
    if "claude" in m_lower and "3.7" in m_lower:
        return rate_cards.get("claude-3-7-sonnet", rate_cards["default"])
    if "claude" in m_lower and "opus" in m_lower:
        return rate_cards.get("claude-opus-5-5", rate_cards["default"])
    if "claude" in m_lower and "sonnet" in m_lower:
        return rate_cards.get("claude-3-5-sonnet", rate_cards["default"])
    if "claude" in m_lower and "haiku" in m_lower:
        return rate_cards.get("claude-3-5-haiku", rate_cards["default"])
    if "gpt-4o-mini" in m_lower:
        return rate_cards.get("gpt-4o-mini", rate_cards["default"])
    if "gpt-4o" in m_lower:
        return rate_cards.get("gpt-4o", rate_cards["default"])
    if "1.5-pro" in m_lower or "1.5 pro" in m_lower:
        return rate_cards.get("gemini-1.5-pro", rate_cards["default"])
    if "1.5-flash" in m_lower or "1.5 flash" in m_lower:
        return rate_cards.get("gemini-1.5-flash", rate_cards["default"])
    if "2.0-flash" in m_lower or "2.0 flash" in m_lower:
        return rate_cards.get("gemini-2.0-flash", rate_cards["default"])
    if "gemini" in m_lower:
        return rate_cards.get("gemini-3.8-flash", rate_cards["default"])
    return rate_cards["default"]


def calculate_turn_cost(
    model_str: str,
    cached_context_tokens: int,
    input_tokens: int,
    thinking_tokens: int,
    tool_tokens: int,
    output_tokens: int,
    rate_cards: Dict[str, Dict[str, Any]],
) -> Dict[str, Any]:
    card = match_rate_card(model_str, rate_cards)
    p_in = card.get("input", 1.0)
    p_cache = card.get("cache", 0.25)
    p_think = card.get("reasoning", p_in)
    p_out = card.get("output", 4.0)

    cached_cost = (cached_context_tokens / 1_000_000.0) * p_cache
    input_cost = (input_tokens / 1_000_000.0) * p_in
    think_cost = (thinking_tokens / 1_000_000.0) * p_think
    tool_cost = (tool_tokens / 1_000_000.0) * p_in
    output_cost = (output_tokens / 1_000_000.0) * p_out

    total = cached_cost + input_cost + think_cost + tool_cost + output_cost
    return {
        "cached_cost": cached_cost,
        "input_cost": input_cost,
        "think_cost": think_cost,
        "tool_cost": tool_cost,
        "output_cost": output_cost,
        "total_cost": total,
        "formatted": f"${total:.4f}" if total >= 0.0001 else "< $0.0001",
        "rate_card": card,
    }


def estimate_tokens(text: str) -> int:
    if not text:
        return 0
    return max(1, len(text) // 4)


def clean_user_prompt(raw: str) -> str:
    if not raw:
        return ""
    m = re.search(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", raw, flags=re.DOTALL)
    if m:
        return m.group(1).strip()
    cleaned = re.sub(r"<[A-Z_]+>.*?</[A-Z_]+>", "", raw, flags=re.DOTALL).strip()
    return cleaned or raw.strip()


def parse_user_step_content(content: str) -> Dict[str, Any]:
    if not content:
        return {
            "raw": "",
            "user_request": "",
            "additional_metadata": "",
            "user_settings": "",
            "context_summary": "",
            "is_compacted": False,
        }

    m_req = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", content, re.DOTALL)
    user_request = m_req.group(1).strip() if m_req else clean_user_prompt(content)

    m_meta = re.search(r"<ADDITIONAL_METADATA>(.*?)</ADDITIONAL_METADATA>", content, re.DOTALL)
    additional_metadata = m_meta.group(1).strip() if m_meta else ""

    m_sett = re.search(r"<USER_SETTINGS_CHANGE>(.*?)</USER_SETTINGS_CHANGE>", content, re.DOTALL)
    user_settings = m_sett.group(1).strip() if m_sett else ""

    m_summ = re.search(r"<CONTEXT_SUMMARY>(.*?)</CONTEXT_SUMMARY>", content, re.DOTALL)
    context_summary = m_summ.group(1).strip() if m_summ else ""

    return {
        "raw": content,
        "user_request": user_request,
        "additional_metadata": additional_metadata,
        "user_settings": user_settings,
        "context_summary": context_summary,
        "is_compacted": bool(m_summ),
    }


def extract_model_changes(raw: str) -> List[str]:
    if not raw or "Model" not in raw:
        return []
    settings_blocks = re.findall(r"<USER_SETTINGS_CHANGE>(.*?)</USER_SETTINGS_CHANGE>", raw, flags=re.DOTALL)
    if not settings_blocks:
        return []
    res = []
    for blk in settings_blocks:
        m = re.search(r"setting\s+[`'\"]?(?:Model|Model Selection)[`'\"]?\s+from\s+[`'\"]?.*?[`'\"]?\s+to\s+[`'\"]?([A-Za-z0-9\.\-\s\(\)]+?)(?:\.\s*(?:No need to comment|$)|[`'\"]?\n|[`'\"]?$)", blk)
        if m:
            val = m.group(1).strip()
            if val and len(val) < 60:
                res.append(val)
    return res


def load_title(conv_id: str) -> str:
    pbtxt = ANNOTATIONS_DIR / f"{conv_id}.pbtxt"
    if pbtxt.exists():
        try:
            content = pbtxt.read_text(encoding="utf-8", errors="replace")
            m = re.search(r'title:\s*"([^"]+)"', content)
            if m:
                return m.group(1)
        except Exception:
            pass
    return ""


def parse_iso_ts(ts_str: str) -> Optional[float]:
    if not ts_str:
        return None
    try:
        dt = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
        return dt.timestamp()
    except Exception:
        return None


def fmt_duration(seconds: int) -> str:
    if seconds < 0:
        return "0s"
    h = seconds // 3600
    m = (seconds % 3600) // 60
    s = seconds % 60
    if h > 0:
        return f"{h}h {m:02d}m {s:02d}s"
    if m > 0:
        return f"{m}m {s:02d}s"
    return f"{s}s"


def find_git_root(path: str) -> Optional[str]:
    try:
        p = Path(path).resolve()
        if p.is_file():
            p = p.parent
        for candidate in [p] + list(p.parents):
            if (candidate / ".git").exists():
                return str(candidate)
    except Exception:
        pass
    return None


def get_git_diff_data(workspace_dir: Optional[str], edited_files: Optional[List[str]] = None) -> Dict[str, Any]:
    repo_path = Path(workspace_dir) if workspace_dir else FLEET_ROOT
    git_dir = repo_path / ".git"

    if not git_dir.exists():
        return {
            "is_git": False,
            "workspace": str(repo_path),
            "branch": "",
            "files_modified_count": 0,
            "untracked_count": 0,
            "total_additions": 0,
            "total_deletions": 0,
            "diffs_by_file": {},
            "raw_diff": "(Workspace is not a Git repository)",
        }

    branch = "unknown"
    try:
        res = subprocess.run(
            ["git", "-C", str(repo_path), "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        if res.returncode == 0:
            branch = res.stdout.strip()
    except Exception:
        pass

    untracked_files: List[str] = []
    try:
        res = subprocess.run(
            ["git", "-C", str(repo_path), "status", "--porcelain"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                if line.startswith("??"):
                    untracked_files.append(line[3:].strip())
    except Exception:
        pass

    diff_cmd = ["git", "-C", str(repo_path), "diff", "HEAD"]
    raw_diff = ""
    try:
        res = subprocess.run(diff_cmd, capture_output=True, text=True, timeout=3, check=False)
        if res.returncode == 0:
            raw_diff = res.stdout
    except Exception:
        pass

    if not raw_diff:
        try:
            res = subprocess.run(
                ["git", "-C", str(repo_path), "diff"],
                capture_output=True,
                text=True,
                timeout=3,
                check=False,
            )
            if res.returncode == 0:
                raw_diff = res.stdout
        except Exception:
            pass

    file_diffs: Dict[str, Dict[str, Any]] = {}
    current_file: Optional[str] = None
    current_lines: List[str] = []
    total_adds = 0
    total_dels = 0

    if raw_diff:
        for line in raw_diff.splitlines():
            if line.startswith("diff --git"):
                if current_file:
                    file_diffs[current_file] = {
                        "path": current_file,
                        "lines": current_lines,
                        "additions": sum(1 for l in current_lines if l.startswith("+") and not l.startswith("+++")),
                        "deletions": sum(1 for l in current_lines if l.startswith("-") and not l.startswith("---")),
                    }
                m = re.search(r" b/(.+)$", line)
                current_file = m.group(1) if m else "unknown"
                current_lines = [line]
            else:
                if current_file:
                    current_lines.append(line)
                    if line.startswith("+") and not line.startswith("+++"):
                        total_adds += 1
                    elif line.startswith("-") and not line.startswith("---"):
                        total_dels += 1

        if current_file:
            file_diffs[current_file] = {
                "path": current_file,
                "lines": current_lines,
                "additions": sum(1 for l in current_lines if l.startswith("+") and not l.startswith("+++")),
                "deletions": sum(1 for l in current_lines if l.startswith("-") and not l.startswith("---")),
            }

    for uf in untracked_files:
        if uf not in file_diffs:
            full_path = repo_path / uf
            u_lines = [f"diff --untracked a/{uf} b/{uf}", "--- /dev/null", f"+++ b/{uf}"]
            u_adds = 0
            if full_path.exists() and full_path.is_file():
                try:
                    for l in full_path.read_text(encoding="utf-8", errors="replace").splitlines()[:100]:
                        u_lines.append(f"+{l}")
                        u_adds += 1
                except Exception:
                    u_lines.append("+(Binary or unreadable untracked file)")
            file_diffs[uf] = {
                "path": uf,
                "lines": u_lines,
                "additions": u_adds,
                "deletions": 0,
                "untracked": True,
            }
            total_adds += u_adds

    return {
        "is_git": True,
        "workspace": str(repo_path),
        "branch": branch,
        "files_modified_count": len(file_diffs),
        "untracked_count": len(untracked_files),
        "total_additions": total_adds,
        "total_deletions": total_dels,
        "diffs_by_file": file_diffs,
        "raw_diff": raw_diff or "(No uncommitted diffs)",
    }


def get_system_prompt_info(workspace_dir: str, conv_id: str) -> Dict[str, Any]:
    ws = Path(workspace_dir) if workspace_dir else FLEET_ROOT
    if not ws.exists():
        ws = FLEET_ROOT

    # 1. Rules from AGENTS.md
    agents_path = ws / "AGENTS.md"
    if not agents_path.exists():
        agents_path = FLEET_ROOT / "AGENTS.md"

    agents_rules: List[Dict[str, Any]] = []
    raw_agents_text = ""
    if agents_path.exists():
        try:
            raw_agents_text = agents_path.read_text(encoding="utf-8", errors="replace")
            current_rule: Optional[Dict[str, Any]] = None
            for line in raw_agents_text.splitlines():
                line_s = line.strip()
                if line_s.startswith("## ") or (line_s.startswith("# ") and not line_s.startswith("# Workspace Rules")):
                    if current_rule:
                        agents_rules.append(current_rule)
                    current_rule = {"title": line_s.lstrip("#").strip(), "points": []}
                elif current_rule and (line_s.startswith("- ") or line_s.startswith("* ") or re.match(r"^\d+\.", line_s)):
                    current_rule["points"].append(line_s)
            if current_rule:
                agents_rules.append(current_rule)
        except Exception:
            pass

    # 2. Installed Skills
    skills: List[Dict[str, Any]] = []
    skills_search_dirs = [
        ws / ".agents" / "skills",
        ws / "skills",
        FLEET_ROOT / ".agents" / "skills",
        FLEET_ROOT / "skills",
    ]
    seen_skills: Set[str] = set()
    for sdir in skills_search_dirs:
        if sdir.exists():
            for child in sorted(sdir.iterdir()):
                if child.name not in seen_skills and (child.is_dir() or child.is_symlink()):
                    sm = child / "SKILL.md"
                    if sm.exists():
                        try:
                            txt = sm.read_text(encoding="utf-8", errors="replace")
                            m_desc = re.search(r"description:\s*(?:>-\s*)?([^\n\r]+(?:\n\s+[^\n\r]+)*)", txt)
                            desc = re.sub(r"\s+", " ", m_desc.group(1).strip()) if m_desc else "No description provided."
                            skills.append({
                                "name": child.name,
                                "description": desc,
                                "path": str(sm),
                            })
                            seen_skills.add(child.name)
                        except Exception:
                            pass

    # 3. Subagents Roster
    subagent_types = [
        {
            "name": "self",
            "role": "Recursive Subagent",
            "desc": "Inherits parent agent full configuration including all tools, system prompt, and active model. Used for task isolation.",
        },
        {
            "name": "research",
            "role": "Codebase & Web Researcher",
            "desc": "Read-only sandbox specialist with web search, file reading, and symbol exploration. Runs without network write access.",
        },
        {
            "name": "image-generator",
            "role": "Visual Designer",
            "desc": "Generates, edits, and crops visual diagrams, icons, and UI assets from text briefs, saving them to disk.",
        },
        {
            "name": "firestore-rules-author",
            "role": "Firestore Rules Specialist",
            "desc": "Mandatory specialist subagent for authoring, auditing, and hardening Cloud Firestore Security Rules (firestore.rules).",
        },
        {
            "name": "swarm-worker",
            "role": "Collaborative Swarm Agent",
            "desc": "Autonomous swarm worker communicating asynchronously via shared message board with dedicated roster name and workspace.",
        },
    ]

    # 4. Native Tools Catalog
    native_tools = [
        {"name": "run_command", "cat": "Execution", "desc": "Execute shell commands in the workspace with background task persistence."},
        {"name": "read_file", "cat": "Filesystem", "desc": "Read text, source code, images, PDF, and audio files with line offsets."},
        {"name": "write_file", "cat": "Filesystem", "desc": "Create a new file or append to an existing file with artifact metadata."},
        {"name": "edit_file", "cat": "Filesystem", "desc": "Perform exact string replacements for surgical contiguous block edits."},
        {"name": "invoke_subagent", "cat": "Multi-Agent", "desc": "Launch specialized subagents asynchronously with dedicated roles and prompts."},
        {"name": "send_message", "cat": "Multi-Agent", "desc": "Deliver messages to other agent conversations via unique conversation IDs."},
        {"name": "manage_subagents", "cat": "Multi-Agent", "desc": "List active direct subagents or terminate running subagents."},
        {"name": "manage_task", "cat": "Orchestration", "desc": "List running background tasks, check status, send input, or kill tasks."},
        {"name": "schedule", "cat": "Orchestration", "desc": "Schedule one-shot timers or recurring cron jobs with reactive wakeups."},
        {"name": "run_workflow", "cat": "Orchestration", "desc": "Run dynamic Python workflow scripts to coordinate fan-out and pipeline stages."},
        {"name": "swarm", "cat": "Swarm", "desc": "Manage swarm roster (add, status, models, model, kill, title) on shared message board."},
        {"name": "post_message", "cat": "Swarm", "desc": "Post public updates or @mentions to the shared swarm message board."},
        {"name": "read_board", "cat": "Swarm", "desc": "Read chronological messages from the shared swarm message board."},
        {"name": "swarm_wait", "cat": "Swarm", "desc": "Sleep cost-free until another swarm worker posts on the shared board."},
        {"name": "ask_question", "cat": "Interaction", "desc": "Prompt user with structured multiple-choice interactive questions."},
        {"name": "search_web", "cat": "Research", "desc": "Execute live web searches with domain filters and URL citations."},
    ]

    # 5. MCP Tools Catalog
    mcp_tools: List[Dict[str, Any]] = []
    mcp_dir = Path.home() / ".gemini" / "antigravity-cli" / "mcp"
    if mcp_dir.exists():
        for sdir in mcp_dir.iterdir():
            if sdir.is_dir():
                for jf in sdir.glob("*.json"):
                    try:
                        d = json.loads(jf.read_text(encoding="utf-8"))
                        mcp_tools.append({
                            "server": sdir.name,
                            "name": jf.stem,
                            "desc": d.get("description", "MCP external tool"),
                            "path": str(jf),
                        })
                    except Exception:
                        pass

    # 6. Reconstructed Full System Prompt Assembly
    skills_text_block = "\n".join(f"- {s['name']}: {s['description']}" for s in skills)
    native_tools_block = "\n".join(f"- {t['name']} ({t['cat']}): {t['desc']}" for t in native_tools)
    mcp_tools_block = "\n".join(f"- {m['name']} [{m['server']}]: {m['desc']}" for m in mcp_tools)

    assembled_prompt = f"""<identity>
You are Antigravity, a powerful agentic AI assistant designed by the Google DeepMind team.
You are working with a USER to solve their task.
The USER will send you requests, which you must always prioritize addressing. User requests are enclosed within <USER_REQUEST> tags.
</identity>

<user_rules>
{raw_agents_text.strip()}
</user_rules>

<skills>
{skills_text_block}
</skills>

<native_tools>
{native_tools_block}
</native_tools>

<mcp_tools>
{mcp_tools_block}
</mcp_tools>

<user_information>
The USER's OS version is mac.
Active Workspace: {ws}
Command Working Directory: {ws}
Conversation ID: {conv_id}
App Data Directory: {Path.home() / ".gemini" / "antigravity-cli"}
</user_information>"""

    return {
        "identity": "Antigravity by Google DeepMind",
        "workspace": str(ws),
        "agents_rules_path": str(agents_path),
        "agents_rules": agents_rules,
        "raw_agents_text": raw_agents_text,
        "skills": skills,
        "subagent_types": subagent_types,
        "native_tools": native_tools,
        "mcp_tools": mcp_tools,
        "assembled_prompt": assembled_prompt,
    }


def parse_conversation(conv_dir: Path, rate_cards: Dict[str, Dict[str, Any]]) -> Optional[Dict[str, Any]]:
    conv_id = conv_dir.name
    logs_dir = conv_dir / ".system_generated" / "logs"
    transcript_path = logs_dir / "transcript_full.jsonl"
    if not transcript_path.exists():
        transcript_path = logs_dir / "transcript.jsonl"
    if not transcript_path.exists():
        return None

    try:
        mtime = transcript_path.stat().st_mtime
    except OSError:
        return None

    steps: List[Dict[str, Any]] = []
    try:
        with open(transcript_path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    steps.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except OSError:
        return None

    if not steps:
        return None

    current_model = "Default (Inherited)"
    models_seen: List[str] = []
    subagents: List[Dict[str, Any]] = []
    prompts: List[Dict[str, Any]] = []

    current_turn: Optional[Dict[str, Any]] = None
    cumulative_context_tokens = 0
    total_input_tokens = 0
    total_thinking_tokens = 0
    total_tool_tokens = 0
    total_output_tokens = 0
    total_estimated_spend = 0.0

    touched_paths: Dict[str, Dict[str, Any]] = {}
    detected_git_roots: List[str] = []

    first_step_time = steps[0].get("created_at", "")
    last_step_time = steps[-1].get("created_at", "")

    for i, step in enumerate(steps):
        source = step.get("source", "")
        stype = step.get("type", "")
        status = step.get("status", "")
        created_at = step.get("created_at", "")
        content = str(step.get("content", "") or "")
        thinking = str(step.get("thinking", "") or "")
        tool_calls = step.get("tool_calls", []) or []

        for m in extract_model_changes(content):
            current_model = m
            if m not in models_seen:
                models_seen.append(m)

        for tc in tool_calls:
            tname = tc.get("name", "")
            args = tc.get("args", {}) or {}
            for path_key in ("Path", "Cwd"):
                if path_key in args:
                    p_val = str(args[path_key]).strip('"')
                    if os.path.isabs(p_val):
                        root = find_git_root(p_val)
                        if root:
                            detected_git_roots.append(root)
                        mode = "EDITED" if tname in ("write_file", "edit_file") else "READ"
                        if p_val not in touched_paths or mode == "EDITED":
                            touched_paths[p_val] = {
                                "path": p_val,
                                "name": os.path.basename(p_val),
                                "mode": mode,
                                "tool": tname,
                                "step": step.get("step_index", i),
                            }
            if tname == "run_command" and "CommandLine" in args:
                cmd = str(args["CommandLine"])
                for match in re.findall(r"(?:/Users/[^\s\"']+|/\w+/[^\s\"']+)", cmd):
                    root = find_git_root(match)
                    if root:
                        detected_git_roots.append(root)

        if source == "USER_EXPLICIT" and stype == "USER_INPUT":
            parsed_step = parse_user_step_content(content)
            in_tok = estimate_tokens(content)
            cached_context = cumulative_context_tokens
            cumulative_context_tokens += in_tok
            total_input_tokens += in_tok

            t_cost = calculate_turn_cost(
                current_model,
                cached_context,
                in_tok,
                0,
                0,
                0,
                rate_cards,
            )
            total_estimated_spend += t_cost["total_cost"]

            m_changes = extract_model_changes(content)
            current_turn = {
                "turn_index": len(prompts) + 1,
                "step_index": step.get("step_index", i),
                "timestamp": created_at,
                "model": current_model,
                "model_switched": m_changes[0] if m_changes else None,
                "prompt": parsed_step["user_request"],
                "raw_payload": parsed_step["raw"],
                "additional_metadata": parsed_step["additional_metadata"],
                "user_settings": parsed_step["user_settings"],
                "context_summary": parsed_step["context_summary"],
                "is_compacted": parsed_step["is_compacted"],
                "prior_context_tokens": cached_context,
                "input_tokens": in_tok,
                "thinking_tokens": 0,
                "tool_tokens": 0,
                "output_tokens": 0,
                "turn_total_tokens": in_tok,
                "cumulative_context_tokens": cumulative_context_tokens,
                "cost": t_cost,
                "tools_used": [],
                "steps": [],
                "flow_nodes": [
                    {
                        "id": f"p-{len(prompts)+1}",
                        "type": "prompt",
                        "category": "prompt",
                        "title": f"Turn #{len(prompts)+1}",
                        "subtitle": parsed_step["user_request"][:50] + ("..." if len(parsed_step["user_request"]) > 50 else ""),
                        "full_text": parsed_step["user_request"],
                        "tokens": in_tok,
                        "timestamp": created_at,
                    }
                ],
                "status": status,
            }
            prompts.append(current_turn)
            continue

        if current_turn is None:
            current_turn = {
                "turn_index": 1,
                "step_index": step.get("step_index", i),
                "timestamp": created_at,
                "model": current_model,
                "model_switched": None,
                "prompt": "(System / Subagent Initialized Thread)",
                "raw_payload": content,
                "additional_metadata": "",
                "user_settings": "",
                "context_summary": "",
                "is_compacted": False,
                "prior_context_tokens": 0,
                "input_tokens": 0,
                "thinking_tokens": 0,
                "tool_tokens": 0,
                "output_tokens": 0,
                "turn_total_tokens": 0,
                "cumulative_context_tokens": cumulative_context_tokens,
                "cost": calculate_turn_cost(current_model, 0, 0, 0, 0, 0, rate_cards),
                "tools_used": [],
                "steps": [],
                "flow_nodes": [],
                "status": status,
            }
            prompts.append(current_turn)

        current_turn["model"] = current_model
        current_turn["status"] = status

        step_record = {
            "step_index": step.get("step_index", i),
            "source": source,
            "type": stype,
            "status": status,
            "timestamp": created_at,
            "tool_calls": [],
            "thinking_preview": thinking[:280] + ("..." if len(thinking) > 280 else "") if thinking else "",
            "has_full_thinking": len(thinking) > 280,
            "content_preview": content[:360] + ("..." if len(content) > 360 else "") if content else "",
            "has_full_output": len(content) > 360 or bool(step.get("truncated_fields")),
        }

        if thinking:
            current_turn["flow_nodes"].append({
                "id": f"think-{step.get('step_index', i)}",
                "type": "thinking",
                "category": "thinking",
                "title": f"Thought #{step.get('step_index', i)}",
                "subtitle": thinking[:56] + ("..." if len(thinking) > 56 else ""),
                "full_text": thinking,
                "step_index": step.get("step_index", i),
                "timestamp": created_at,
            })

        if stype == "PLANNER_RESPONSE":
            th_tok = estimate_tokens(thinking)
            out_tok = estimate_tokens(content)
            tc_str = json.dumps(tool_calls, ensure_ascii=False) if tool_calls else ""
            tc_tok = estimate_tokens(tc_str) if tool_calls else 0

            current_turn["thinking_tokens"] += th_tok
            current_turn["output_tokens"] += out_tok
            current_turn["tool_tokens"] += tc_tok

            total_thinking_tokens += th_tok
            total_output_tokens += out_tok
            total_tool_tokens += tc_tok

            cumulative_context_tokens += (out_tok + tc_tok)
            current_turn["turn_total_tokens"] += (th_tok + out_tok + tc_tok)
            current_turn["cumulative_context_tokens"] = cumulative_context_tokens

            for tc_idx, tc in enumerate(tool_calls):
                tname = tc.get("name", "unknown")
                current_turn["tools_used"].append(tname)
                args = tc.get("args", {}) or {}
                summary = tc.get("toolSummary") or str(args.get("toolSummary") or "")

                step_record["tool_calls"].append({
                    "name": tname,
                    "summary": summary,
                    "args": args,
                })

                cat = (
                    "shell"
                    if tname == "run_command"
                    else (
                        "fs_edit"
                        if tname in ("write_file", "edit_file")
                        else ("fs_read" if tname == "read_file" else ("agent" if tname in ("invoke_subagent", "swarm") else "mcp"))
                    )
                )
                cmd_or_path = str(args.get("CommandLine") or args.get("Path") or summary or "")
                current_turn["flow_nodes"].append({
                    "id": f"tool-{step.get('step_index', i)}-{tc_idx}",
                    "type": "tool",
                    "category": cat,
                    "title": tname,
                    "subtitle": cmd_or_path[:48] + ("..." if len(cmd_or_path) > 48 else ""),
                    "args": args,
                    "summary": summary,
                    "step_index": step.get("step_index", i),
                    "timestamp": created_at,
                    "output_preview": content[:180] if content else "",
                })

                if tname == "invoke_subagent":
                    subagents.append({
                        "kind": "subagent",
                        "role": str(args.get("Role", "")).strip('"'),
                        "type": str(args.get("TypeName", "")).strip('"'),
                        "model": str(args.get("Model", "inherit")).strip('"'),
                        "timestamp": created_at,
                    })
                elif tname == "swarm":
                    action = str(args.get("action", "")).strip('"')
                    if action == "add":
                        subagents.append({
                            "kind": "swarm-worker",
                            "role": str(args.get("name", "worker")).strip('"'),
                            "type": "swarm",
                            "model": str(args.get("model", current_model)).strip('"') or current_model,
                            "timestamp": created_at,
                        })
        else:
            tok = estimate_tokens(content)
            current_turn["tool_tokens"] += tok
            total_tool_tokens += tok
            cumulative_context_tokens += tok
            current_turn["turn_total_tokens"] += tok
            current_turn["cumulative_context_tokens"] = cumulative_context_tokens

        # Recalculate cost
        current_turn["cost"] = calculate_turn_cost(
            current_turn["model"],
            current_turn["cumulative_context_tokens"] - current_turn["turn_total_tokens"],
            current_turn["input_tokens"],
            current_turn["thinking_tokens"],
            current_turn["tool_tokens"],
            current_turn["output_tokens"],
            rate_cards,
        )
        current_turn["steps"].append(step_record)

    last_step = steps[-1]
    last_status = last_step.get("status", "DONE")
    last_type = last_step.get("type", "")
    last_has_tools = bool(last_step.get("tool_calls"))
    age_seconds = time.time() - mtime

    is_working = (
        age_seconds < 120
        and (
            last_status == "RUNNING"
            or (last_type == "PLANNER_RESPONSE" and last_has_tools)
            or last_type == "USER_INPUT"
        )
    )
    live_state = "WORKING" if is_working else ("RECENT" if age_seconds < 900 else "IDLE")

    title = load_title(conv_id)
    if not title and prompts:
        first_p = prompts[0]["prompt"]
        title = (first_p[:56] + "…") if len(first_p) > 56 else first_p
    if not title:
        title = conv_id[:8]

    session_rate = match_rate_card(current_model, rate_cards)
    ctx_limit = session_rate.get("context_limit", 200000)
    saturation_pct = min(100.0, round((cumulative_context_tokens / max(1, ctx_limit)) * 100, 1))
    saturation_status = "healthy" if saturation_pct < 70 else ("warning" if saturation_pct < 90 else "critical")

    primary_workspace = str(FLEET_ROOT)
    if detected_git_roots:
        counts = Counter(detected_git_roots)
        primary_workspace = counts.most_common(1)[0][0]

    # Timing & duration calculation
    start_ts = parse_iso_ts(first_step_time) or mtime
    last_ts = parse_iso_ts(last_step_time) or mtime
    if is_working:
        duration_sec = max(1, int(time.time() - start_ts))
    else:
        duration_sec = max(1, int(last_ts - start_ts)) if last_ts > start_ts else int(mtime - start_ts if mtime > start_ts else 1)

    return {
        "id": conv_id,
        "title": title,
        "mtime": mtime,
        "start_time": first_step_time,
        "start_ts_ms": int(start_ts * 1000),
        "duration_seconds": duration_sec,
        "duration_formatted": fmt_duration(duration_sec),
        "last_updated": datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M:%S"),
        "live_state": live_state,
        "is_active": is_working,
        "current_model": current_model,
        "models_seen": models_seen or [current_model],
        "subagents": subagents,
        "steps_count": len(steps),
        "prompts_count": len(prompts),
        "total_input_tokens": total_input_tokens,
        "total_thinking_tokens": total_thinking_tokens,
        "total_tool_tokens": total_tool_tokens,
        "total_output_tokens": total_output_tokens,
        "total_context_tokens": cumulative_context_tokens,
        "total_tokens": cumulative_context_tokens + total_thinking_tokens,
        "estimated_spend": total_estimated_spend,
        "cost_formatted": f"${total_estimated_spend:.4f}" if total_estimated_spend >= 0.0001 else "< $0.0001",
        "context_saturation": {
            "limit": ctx_limit,
            "tokens": cumulative_context_tokens,
            "percent": saturation_pct,
            "status": saturation_status,
        },
        "workspace": primary_workspace,
        "touched_files": list(touched_paths.values()),
        "prompts": prompts,
    }


def collect_all_traces() -> List[Dict[str, Any]]:
    rate_cards = load_rate_cards()
    convs: List[Dict[str, Any]] = []
    if not BRAIN_DIR.exists():
        return convs
    for child in BRAIN_DIR.iterdir():
        if child.is_dir():
            parsed = parse_conversation(child, rate_cards)
            if parsed:
                convs.append(parsed)
    convs.sort(key=lambda c: c["mtime"], reverse=True)
    return convs


def fmt_num(n: int) -> str:
    return f"{n:,}"


def generate_markdown(convs: List[Dict[str, Any]]) -> str:
    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    total_convs = len(convs)
    total_prompts = sum(c["prompts_count"] for c in convs)
    total_steps = sum(c["steps_count"] for c in convs)
    grand_tokens = sum(c["total_tokens"] for c in convs)
    grand_in = sum(c["total_input_tokens"] for c in convs)
    grand_think = sum(c["total_thinking_tokens"] for c in convs)
    grand_tool = sum(c["total_tool_tokens"] for c in convs)
    grand_out = sum(c["total_output_tokens"] for c in convs)
    grand_cost = sum(c["estimated_spend"] for c in convs)

    working_convs = [c for c in convs if c["live_state"] in ("WORKING", "RECENT")]
    all_models = sorted({m for c in convs for m in c["models_seen"]})

    lines = [
        "# Agent Trace, Token & Dollar Cost Telemetry Dashboard",
        "",
        f"> **Last Synced**: `{now_str}` · **Live UI**: [http://127.0.0.1:8765](http://127.0.0.1:8765) · **Visual System**: Obsidian Telemetry HUD (Linear/Anduril/Stripe Precision Dark)",
        "",
        "---",
        "",
        "## Global Telemetry & Cost Summary",
        "",
        "| Metric | Value | Breakdown / Estimation Basis |",
        "| :--- | :--- | :--- |",
        f"| **Tracked Conversations** | **{total_convs}** | `{len(working_convs)}` Active/Recent · `{total_convs - len(working_convs)}` Idle |",
        f"| **Total Prompts / Steps** | **{fmt_num(total_prompts)} prompts** | **{fmt_num(total_steps)}** total execution steps |",
        f"| **Estimated API Spend ($ USD)** | **${grand_cost:.4f}** | Estimated via standard rate cards (~chars/4 heuristic) |",
        f"| **Cumulative Token Volume** | **~{fmt_num(grand_tokens)} tokens** | Input: `{fmt_num(grand_in)}` · Thinking: `{fmt_num(grand_think)}` · Tools: `{fmt_num(grand_tool)}` · Output: `{fmt_num(grand_out)}` |",
        f"| **Models Detected** | **{len(all_models)} models** | {', '.join(f'`{m}`' for m in all_models)} |",
        "",
        "---",
        "",
        "## Active & Recent Sessions (Model, Cost & Context Saturation)",
        "",
        "| Status | Conversation | Active Model | Runtime | Prompts | Context Saturation | Est. Cost ($) | Input Tok | Thinking Tok | Tool IO Tok | Output Tok | Last Active |",
        "| :---: | :--- | :--- | :---: | :---: | :---: | :---: | :---: | :---: | :---: | :---: | :--- |",
    ]

    for c in convs[:25]:
        badge = "WORKING" if c["live_state"] == "WORKING" else ("RECENT" if c["live_state"] == "RECENT" else "IDLE")
        sat = c["context_saturation"]
        sat_str = f"`{sat['percent']}%` ({fmt_num(sat['tokens'])}/{fmt_num(sat['limit'])})"
        safe_title = c["title"].replace("|", "·").replace("\n", " ")[:40]
        lines.append(
            f"| {badge} | **{safe_title}**<br>`{c['id'][:8]}` | `{c['current_model']}` | `{c['duration_formatted']}` | {c['prompts_count']} | "
            f"{sat_str} | **`{c['cost_formatted']}`** | `{fmt_num(c['total_input_tokens'])}` | `{fmt_num(c['total_thinking_tokens'])}` | "
            f"`{fmt_num(c['total_tool_tokens'])}` | `{fmt_num(c['total_output_tokens'])}` | `{c['last_updated']}` |"
        )

    lines.extend([
        "",
        "---",
        "",
        "## Subagents & Multi-Model Workers Spawned",
        "",
        "| Parent Session | Worker Role / Name | Type | Assigned Model | Timestamp |",
        "| :--- | :--- | :--- | :--- | :--- |",
    ])

    any_sub = False
    for c in convs:
        for s in c["subagents"]:
            any_sub = True
            lines.append(
                f"| **{c['title'][:32]}** (`{c['id'][:8]}`) | `{s['role']}` | `{s['type']}` | **`{s['model']}`** | `{s['timestamp']}` |"
            )
    if not any_sub:
        lines.append("| *(None recorded)* | — | — | — | — |")

    lines.extend([
        "",
        "---",
        "",
        "## Deep Prompt & Turn Traces (Latest 10 Conversations)",
        "",
    ])

    for c in convs[:10]:
        badge = "WORKING" if c["live_state"] == "WORKING" else ("RECENT" if c["live_state"] == "RECENT" else "IDLE")
        sat = c["context_saturation"]
        lines.extend([
            f"### [{badge}] {c['title']} (`{c['id']}`)",
            f"- **Active Model**: `{c['current_model']}` · **Duration**: `{c['duration_formatted']}` · **Est. Spend**: `{c['cost_formatted']}` · **Context Ceiling**: `{sat['percent']}%` of `{fmt_num(sat['limit'])} tok` · **Workspace**: `{c['workspace']}`",
            "",
            "| Turn | Prompt Preview | Model | Est. Cost | Prompt In | Thinking | Tool IO | Reply | Context Accum | Tools Invocations |",
            "| :---: | :--- | :--- | :---: | :---: | :---: | :---: | :---: | :---: | :--- |",
        ])
        for p in c["prompts"]:
            preview = p["prompt"].replace("|", "·").replace("\n", " ").strip()
            if len(preview) > 52:
                preview = preview[:49] + "..."
            tools_summary = ", ".join(dict.fromkeys(p["tools_used"])) if p["tools_used"] else "—"
            if len(tools_summary) > 36:
                tools_summary = tools_summary[:33] + "..."
            lines.append(
                f"| `#{p['turn_index']}` | {preview} | `{p['model']}` | **`{p['cost']['formatted']}`** | `{fmt_num(p['input_tokens'])}` | "
                f"`{fmt_num(p['thinking_tokens'])}` | `{fmt_num(p['tool_tokens'])}` | `{fmt_num(p['output_tokens'])}` | "
                f"`{fmt_num(p['cumulative_context_tokens'])}` | `{tools_summary}` |"
            )
        lines.append("")

    return "\n".join(lines)


def sync_markdown_files(convs: List[Dict[str, Any]]) -> List[Path]:
    md = generate_markdown(convs)
    written = []
    targets = [
        FLEET_ROOT / "wiki" / "AGENT_TRACES_DASHBOARD.md",
        FLEET_ROOT / "GIT" / "wiki" / "AGENT_TRACES_DASHBOARD.md",
    ]
    for t in targets:
        try:
            t.parent.mkdir(parents=True, exist_ok=True)
            t.write_text(md, encoding="utf-8")
            written.append(t)
        except Exception:
            pass
    return written


def render_html(
    convs: List[Dict[str, Any]],
    selected_id: Optional[str] = None,
    current_view: str = "overview",
    active_tab: str = "prompts",
    active_turn: Optional[int] = None,
) -> str:
    rate_cards = load_rate_cards()
    total_convs = len(convs)
    total_prompts = sum(c["prompts_count"] for c in convs)
    total_steps = sum(c["steps_count"] for c in convs)
    grand_tokens = sum(c["total_tokens"] for c in convs)
    grand_cost = sum(c["estimated_spend"] for c in convs)

    working_sessions = [c for c in convs if c["live_state"] == "WORKING"]
    recent_sessions = [c for c in convs if c["live_state"] == "RECENT"]
    active_pool = working_sessions or recent_sessions or convs[:4]

    selected = next((c for c in convs if c["id"] == selected_id), convs[0] if convs else None)
    edited_paths = [tf["path"] for tf in (selected.get("touched_files", []) if selected else []) if tf.get("mode") == "EDITED"]
    git_data = get_git_diff_data(selected["workspace"] if selected else None, edited_paths)
    system_config = get_system_prompt_info(selected["workspace"] if selected else str(FLEET_ROOT), selected["id"] if selected else "")

    # Fleet Chart Computations
    model_counts: Counter = Counter()
    model_tokens: Counter = Counter()
    tool_counts: Counter = Counter()
    repo_spend: Counter = Counter()

    for c in convs:
        model_counts[c["current_model"]] += 1
        model_tokens[c["current_model"]] += c["total_tokens"]
        repo_spend[os.path.basename(c["workspace"]) or "fleet"] += c["estimated_spend"]
        for p in c.get("prompts", []):
            for t in p.get("tools_used", []):
                tool_counts[t] += 1

    # SVG Chart 1: Model Token Share
    total_m_tok = max(1, sum(model_tokens.values()))
    top_models = model_tokens.most_common(5)
    palette = ["#38BDF8", "#10B981", "#A855F7", "#F59E0B", "#64748B"]
    m_bars_svg = []
    m_legend_html = []
    x_offset = 0.0
    for idx, (m_name, m_tok) in enumerate(top_models):
        pct = (m_tok / total_m_tok) * 100.0
        w = (m_tok / total_m_tok) * 480.0
        c_color = palette[idx % len(palette)]
        m_bars_svg.append(f'<rect x="{x_offset:.1f}" y="0" width="{w:.1f}" height="14" fill="{c_color}"/>')
        x_offset += w
        m_legend_html.append(f"""
        <div class="legend-item">
          <span class="legend-swatch" style="background:{c_color};"></span>
          <span class="mono">{html.escape(m_name)}</span>
          <span class="mono muted">{pct:.1f}% ({fmt_num(m_tok)} tok)</span>
        </div>
        """)
    model_share_svg = f"""
    <svg width="100%" height="14" viewBox="0 0 480 14" preserveAspectRatio="none" style="border-radius:4px; overflow:hidden;">
      {''.join(m_bars_svg)}
    </svg>
    """

    # SVG Chart 2: Top Invoked Tools
    top_tools = tool_counts.most_common(6)
    max_t_val = max((v for _, v in top_tools), default=1)
    tool_bars_svg = []
    y_pos = 6
    for t_name, t_val in top_tools:
        bw = int((t_val / max_t_val) * 240)
        tool_bars_svg.append(f"""
        <g class="chart-row">
          <text x="0" y="{y_pos+11}" fill="#94A3B8" font-size="11" font-family="JetBrains Mono, monospace">{html.escape(t_name)}</text>
          <rect x="120" y="{y_pos}" width="{bw}" height="13" rx="3" fill="#38BDF8" opacity="0.85"/>
          <text x="{120 + bw + 8}" y="{y_pos+11}" fill="#F1F5F9" font-size="11" font-weight="600" font-family="JetBrains Mono, monospace">{fmt_num(t_val)}</text>
        </g>
        """)
        y_pos += 22
    tools_chart_svg = f"""
    <svg width="100%" height="{y_pos+4}" viewBox="0 0 440 {y_pos+4}" xmlns="http://www.w3.org/2000/svg">
      {''.join(tool_bars_svg)}
    </svg>
    """

    clock_svg = '<svg class="clock-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:-1px; margin-right:4px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>'

    # Sidebar / Traces Session Rows
    conv_rows = []
