        flow_chain = "".join(flow_node_elements)
        if flow_chain.endswith(flow_arrow_html):
            flow_chain = flow_chain[:-len(flow_arrow_html)]

        map_tracks_html.append(f"""
        <div class="map-turn-track">
          <div class="map-turn-header mono">
