            for tf in selected.get("touched_files", [])
        ) or "<div class='empty'>No files touched in this session.</div>"

        diff_content_html = ""
        if git_data.get("diffs_by_file"):
            diff_cards = []
            for fname, dinfo in git_data["diffs_by_file"].items():
                d_lines = dinfo.get("lines", [])
                rendered_lines = []
                for dl in d_lines:
                    cls = "diff-ctx"
                    if dl.startswith("+") and not dl.startswith("+++"):
                        cls = "diff-add"
                    elif dl.startswith("-") and not dl.startswith("---"):
                        cls = "diff-del"
                    elif dl.startswith("@@"):
                        cls = "diff-hunk"
                    rendered_lines.append(f'<div class="diff-line {cls}">{html.escape(dl)}</div>')

                f_lines_text = "\n".join(rendered_lines)
                diff_cards.append(f"""
                <div class="diff-file-card">
                  <div class="diff-file-header">
                    <span class="diff-filename mono">{html.escape(fname)}</span>
                    <div class="diff-stats mono">
