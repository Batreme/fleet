                    args_pretty = json.dumps(args, indent=2, ensure_ascii=False)
                    t_calls_html.append(f"""
                    <div class="tool-call-block">
                      <div class="tool-call-header">
                        <span class="tool-call-badge mono">{html.escape(tname)}</span>
                        <span class="tool-summary-text">{html.escape(summary)}</span>
