          <polyline points="{ctx_polyline}" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-linecap="round"/>
          <polyline points="{cost_polyline}" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round"/>
        </svg>
        """
