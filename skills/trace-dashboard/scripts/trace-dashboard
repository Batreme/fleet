                <div><span class="dot seg-tool"></span>Tool IO ({len(p.get('steps', []))} steps): <strong>{fmt_num(p['tool_tokens'])}</strong> <span class="muted">(${p['cost']['tool_cost']:.4f})</span></div>
                <div><span class="dot seg-out"></span>Response: <strong>{fmt_num(p['output_tokens'])}</strong> <span class="muted">(${p['cost']['output_cost']:.4f})</span></div>
