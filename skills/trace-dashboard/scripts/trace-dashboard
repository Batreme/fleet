                <div class="bar-seg seg-in" style="width:{w_in}%" title="Input Prompt: {fmt_num(p['input_tokens'])} tok"></div>
                <div class="bar-seg seg-think" style="width:{w_th}%" title="Thinking / Reasoning: {fmt_num(p['thinking_tokens'])} tok"></div>
                <div class="bar-seg seg-tool" style="width:{w_tl}%" title="Tool IO: {fmt_num(p['tool_tokens'])} tok"></div>
                <div class="bar-seg seg-out" style="width:{w_out}%" title="Response: {fmt_num(p['output_tokens'])} tok"></div>
              </div>
              <div class="token-grid mono">
