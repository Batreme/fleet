    # Analytics View: Session Deep-Dive SVG Curves
    session_points = []
    if selected and selected.get("prompts"):
        s_turns = selected["prompts"]
        max_ctx_limit = max(1, selected["context_saturation"]["limit"])
        max_turn_tokens = max((p["turn_total_tokens"] for p in s_turns), default=1)

        ctx_points = []
        cost_points = []
        w_step = 420.0 / max(1, len(s_turns) - 1) if len(s_turns) > 1 else 420.0
        running_cost = 0.0

        for idx, p in enumerate(s_turns):
            px = idx * w_step if len(s_turns) > 1 else 210.0
            ctx_y = 140.0 - ((p["cumulative_context_tokens"] / max_ctx_limit) * 120.0)
            ctx_points.append(f"{px:.1f},{ctx_y:.1f}")

            running_cost += p["cost"]["total_cost"]
            cost_y = 140.0 - min(130.0, (running_cost / max(0.01, selected["estimated_spend"])) * 120.0)
            cost_points.append(f"{px:.1f},{cost_y:.1f}")

        ctx_polyline = " ".join(ctx_points)
        cost_polyline = " ".join(cost_points)

