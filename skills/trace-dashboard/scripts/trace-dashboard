              stroke="{sat_color}" stroke-dasharray="{circ:.2f}" stroke-dashoffset="{dashoffset:.2f}" stroke-linecap="round" />
          </svg>
          <div class="sat-ring-text mono">{sat['percent']}%</div>
        </div>
