          <div class="map-chain-row">
            {flow_chain}
          </div>
        </div>
        """)

    if not map_tracks_html:
        map_tracks_html.append("<div class='empty'>No execution nodes recorded for this selection.</div>")

    # Selected Session Traces View Generation
    detail_html = "<div class='empty'>No conversation selected.</div>"
    if selected:
        sat = selected["context_saturation"]
        sat_badge_cls = (
            "sat-healthy" if sat["status"] == "healthy" else ("sat-warning" if sat["status"] == "warning" else "sat-critical")
        )
        sat_color = "#10B981" if sat["status"] == "healthy" else ("#F59E0B" if sat["status"] == "warning" else "#EF4444")

