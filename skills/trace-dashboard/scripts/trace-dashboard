                  </div>
                  <pre class="diff-code mono">{f_lines_text}</pre>
                </div>
                """)
            diff_content_html = "".join(diff_cards)
        else:
            diff_content_html = "<div class='empty'>No uncommitted git diffs detected. Working tree is clean.</div>"

        # System Prompt Tab HTML Generation
        rules_html = ""
