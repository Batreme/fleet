        <svg width="100%" height="160" viewBox="0 0 440 160" xmlns="http://www.w3.org/2000/svg">
          <line x1="10" y1="20" x2="430" y2="20" stroke="#EF4444" stroke-dasharray="4,4" stroke-width="1"/>
          <text x="330" y="16" fill="#EF4444" font-size="10" font-family="JetBrains Mono, monospace">Model Ceiling (100%)</text>
