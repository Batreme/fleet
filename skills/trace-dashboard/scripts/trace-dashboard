            if sat["status"] == "critical"
            else ""
        )

        prompt_cards = []
        for p in reversed(selected["prompts"]):
            tot = max(1, p["turn_total_tokens"])
            w_in = round(p["input_tokens"] / tot * 100, 1)
            w_th = round(p["thinking_tokens"] / tot * 100, 1)
            w_tl = round(p["tool_tokens"] / tot * 100, 1)
            w_out = max(0.0, round(100.0 - w_in - w_th - w_tl, 1))

            tools_badges = "".join(
                f'<span class="tool-tag mono">{html.escape(t)}</span>'
                for t in dict.fromkeys(p["tools_used"])
            ) or '<span class="muted font-sans">No external tools invoked</span>'

            model_switch_badge = (
                f'<span class="model-switch-pill mono">Model switched to {html.escape(p["model_switched"])}</span>'
                if p.get("model_switched")
                else ""
            )

            raw_meta_html = ""
            if p.get("additional_metadata"):
                raw_meta_html = f"""
                <div class="raw-section">
                  <div class="raw-section-title mono">&lt;ADDITIONAL_METADATA&gt;</div>
