          </div>
          <div class="sat-mini-track" title="Context Saturation: {sat['percent']}% of {fmt_num(sat['limit'])}">
            <div class="sat-mini-fill" style="width:{sat['percent']}%; background:{sat_color};"></div>
          </div>
          <div class="conv-time">{html.escape(c['last_updated'])} · {html.escape(c['id'][:8])}</div>
        </div>
        """)

    # Active Working Sessions Cards (Overview)
    active_cards_html = []
    for ac in active_pool:
        state_cls = "badge-working" if ac["live_state"] == "WORKING" else "badge-recent"
        last_tool = ac["prompts"][-1]["tools_used"][-1] if (ac["prompts"] and ac["prompts"][-1]["tools_used"]) else "LLM Generation"
